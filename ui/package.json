{
  "name": "databrain-ui",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "e2e": "tsc -p e2e/tsconfig.json && playwright test",
    "screenshots": "tsc -p e2e/tsconfig.json && playwright test -c playwright.screenshots.config.ts",
    "tauri": "node ../scripts/tauri.mjs",
    "app:dev": "node ../scripts/tauri.mjs dev",
    "app:build": "node ../scripts/tauri.mjs build",
    "app:build:no-duckdb": "node ../scripts/build-system-duckdb.mjs",
    "app:dev:no-duckdb": "node ../scripts/build-system-duckdb.mjs --dev",
    "fetch:duckdb-ext": "node ../scripts/fetch-duckdb-extensions.mjs",
    "build:oracle-agent": "node ../scripts/build-oracle-agent.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@glideapps/glide-data-grid": "6.0.3",
    "@lezer/highlight": "1.2.5",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "2.3.3",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "lucide-react": "1.49.0",
    "react": "18.3.1",
    "react-dom": "19.3.1",
    "sql-formatter": "15.9.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
