{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataBrain",
  "version": "0.1.0",
  "identifier": "dev.databrain.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run fetch:duckdb-ext && npm run dev",
    "beforeBuildCommand": "npm run fetch:duckdb-ext && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DataBrain",
        "width": 1400,
        "height": 880,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/duckdb-extensions/": "duckdb-extensions/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
