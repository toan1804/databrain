<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened runtime exceptions for the signed, notarized macOS app.
  DataBrain loads libraries it did not sign at runtime: DuckDB's extensions
  (seeded from the bundle into app data, signed by DuckDB's linker only), the
  DuckDB library installed on the computer (builds without bundled DuckDB)
  and Oracle Instant Client. Library validation would refuse them.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
